# ==============================
# 🌩️ S3 STORAGE CONFIGURATION
# ==============================
S3_ACCESS_KEY=your_s3_user
S3_SECRET_KEY=your_s3_password
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=models-bucket
S3_HOST=localhost
S3_REGION=eu-central-1

# ==============================
# ⚙️ BACKEND & FRONTEND
# ==============================
BACKEND_ENDPOINT=http://localhost:8080
FRONTEND_URL=http://localhost:8501

# ==============================
# 🔐 GOOGLE OAUTH 2.0 CREDENTIALS
# ==============================
# Зарегистрируйте OAuth Client в Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# и подставьте свои данные.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# ==============================
# 🪪 JWT CONFIGURATION
# ==============================
# Используется для подписи и проверки JWT токенов.
# Сгенерируйте новый секрет через:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=2

# ==============================
# 🔑 SESSION CONFIGURATION
# ==============================
# Ключ для Starlette SessionMiddleware.
# Также можно сгенерировать через secrets.token_hex(32)
SESSION_SECRET=your_session_secret